import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
	public static void main(String args[]) throws Exception
	{
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt();
        int b = sc.nextInt();
        char answer = ' ';
        
        if (a==1 && b==2 ) {
            answer = 'B';
        } else if (a==1 && b==3) {
            answer = 'A';
        } else if (a==2 && b==1) {
            answer = 'A';
        } else if (a==2 && b==3) {
            answer = 'B';
        } else if (a==3 && b==1) {
            answer = 'B';
        } else if (a==3 && b==2) {
            answer = 'A';
        }
        
        System.out.println(answer);
	}
}